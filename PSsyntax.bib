@article{johnsonGappingNotVP2009,
  title = {Gapping Is Not ({{VP}}-) Ellipsis},
  author = {Johnson, Kyle},
  year = 2009,
  journal = {Linguistic Inquiry},
  volume = {40},
  number = {2},
  pages = {289--328},
  abstract = {Pseudogapping is no misnomer. Despite their many tempting similarities, gapping and pseudogapping are distinct constructions. Pseudo-gapping is a special instance of VP-ellipsis, while gapping, I argue, is a special instance of across-the-board movement. Squeezing gapping into across-the-board movement has its own discomforts, however, which I suggest can be remedied by retailoring our syntax to include string-based output constraints. I sketch one such alteration that involves apparent Left Branch Condition violations.},
  date-added = {2017-10-15 05:13:31 +0000},
  date-modified = {2017-10-15 05:13:32 +0000},
  keywords = {ToRead}
}

@incollection{johnsonGappingStripping2018,
  title = {Gapping and {{Stripping}}},
  booktitle = {The {{Oxford Handbook}} of {{Ellipsis}}},
  author = {Johnson, Kyle},
