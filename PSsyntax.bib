@article{KimEtal2025,
  title = {Incremental Structure Building in the Processing of Ellipsis},
  author = {Kim, Hyosik and Orth, Wesley J and Yoshida, Masaya},
  year = 2025,
  journal = {Quarterly Journal of Experimental Psychology},
  volume = {78},
