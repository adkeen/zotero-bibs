@article{Ojea2020,
  title = {Syntax Meets Discourse: {{Locative}} and Deictic (Directional) Inversion in {{English}}},
  shorttitle = {Syntax Meets Discourse},
  author = {Ojea, Ana},
  year = 2020,
  journal = {Poznan Studies in Contemporary Linguistics},
  volume = {56},
  number = {2},
  pages = {251--276},
  issn = {1897-7499, 0137-2459},
  doi = {10.1515/psicl-2020-0007},
  urldate = {2026-06-21},
  abstract = {Abstract                            This paper offers a formal analysis of three constructions in English:               locative inversion               ,               central deictic inversion               and               directional inversion               . These constructions constitute thetic statements with a locative intentional base which sets a scene that (re)introduces an entity in the discourse; syntactically, they display a non-canonical word order and have a number of unusual grammatical properties which make them particularly interesting to show how syntax connects, and adapts, to discourse. I propose that they all obtain from a language particular mechanism which involves a functional category LocP that adjusts the computational requirement to have a preverbal subject to the intentional need to have the subject post-verbally. As for the differences among them, they are approached in terms of the features that head LocP and the lexical properties of the verbs that head each of the structures. Ultimately, the paper also serves to discuss the role of certain informational features (the so-called               core intentional features               ) in the syntactic derivation.}
}

@article{orthGapsThatNot2025,
  title = {Gaps {{That Do Not Sprout}}},
  author = {Orth, Wesley and Yoshida, Masaya},
  year = 2025,
  journal = {Linguistic Inquiry},
  pages = {1--17},
  issn = {0024-3892, 1530-9150},
  doi = {10.1162/ling_a_00551},
  urldate = {2025-08-05},
  abstract = {Abstract             This squib investigates a prohibition on sprouted remnants in cases of verbal Gapping with an implicit argument in the antecedent. We explore both ellipsis derivations and Across-The-Board-movement derivations for the Gapping structure to determine the underlying cause of this restriction. We find that the ellipsis derivations of verbal Gapping do not block the presence of a sprouted remnant or predict differences in the acceptability of sprouted remnants in verbal Gapping and Pseudogapping. On the other hand, we show that the restriction against sprouting in verbal Gapping constructions is captured as a consequence of issues faced in trace-binding in Across-The-Board-movement.},
  langid = {english},
  keywords = {ToRead}
}

